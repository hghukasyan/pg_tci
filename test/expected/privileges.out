SQL statement "SELECT tci_internal.require_select(source_table)"
PL/pgSQL function count_at(regclass,timestamp with time zone) line 5 at PERFORM
SELECT tci.shard_stats('public.owner_sessions'::regclass); -- fail: no SELECT
ERROR:  pg_tci: permission denied for SELECT on public.owner_sessions
CONTEXT:  PL/pgSQL function tci_internal.require_select(regclass) line 5 at RAISE
SQL statement "SELECT tci_internal.require_select(source_table)"
PL/pgSQL function tci.shard_stats(regclass) line 6 at PERFORM
SELECT tci.health('public.owner_sessions'::regclass); -- fail: no SELECT
ERROR:  pg_tci: permission denied for SELECT on public.owner_sessions
CONTEXT:  PL/pgSQL function tci_internal.require_select(regclass) line 5 at RAISE
SQL statement "SELECT tci_internal.require_select(source_table)"
PL/pgSQL function tci.health(regclass) line 5 at PERFORM
RESET SESSION AUTHORIZATION;
DROP EXTENSION pg_tci CASCADE;
NOTICE:  drop cascades to trigger tci_source_trig on table owner_sessions
DROP TABLE public.owner_sessions;
DROP ROLE tci_stranger;
DROP ROLE tci_reader;
DROP ROLE tci_owner;
